# Desarrollo local (copiar a .env con valores reales: nunca comitear secretos).
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-local-env
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://academix:change-me@db:5432/academix
# Redis con AUTH (solo en desarrollo; en producción usar el runbook de abajo)
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Google OAuth 2.0
# Credenciales desde Google Cloud Console (APIs & Services > Credentials).
# URI de redirección autorizada del callback (local):
#   http://localhost/auth/complete/google-oauth2/
# (y http://localhost:5173/auth/complete/google-oauth2/ si accedés por Vite directo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_DB=academix
POSTGRES_USER=academix
POSTGRES_PASSWORD=change-me

# --- Exposición pública (producción) ---
# 1) DEBUG=false y agregá tu IP/dominio a ALLOWED_HOSTS (coma-separado):
#       DEBUG=false
#       ALLOWED_HOSTS=<tu-ip-o-dominio>,localhost,127.0.0.1
#    CSRF_TRUSTED_ORIGINS se derivan automáticamente de ALLOWED_HOSTS;
#    CORS no es necesario si el SPA se consume same-origin vía nginx.
#    Luego: docker compose up -d --force-recreate backend
# 2) HTTPS delante (recomendado) + estas flags:
#       SECURE_SSL_REDIRECT=true
#       SESSION_COOKIE_SECURE=true
#       CSRF_COOKIE_SECURE=true
#       SECURE_HSTS_SECONDS=31536000
#       SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#       SECURE_HSTS_PRELOAD=true
# 3) URI de redirección autorizada de Google para producción:
#       http(s)://<tu-ip-o-dominio>/auth/complete/google-oauth2/
